config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi+1'
	option hwmode '11a'
	option band '5g'
	option channel '100'
	option htmode 'HE160'
	option country 'TW'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'sta'
	option ssid 'OpenWrt_5G'
	option encryption 'sae'
	option key 'mojeheslo'
	option wds '1'

config wifi-iface 'default_radio3'
        option device 'radio1'    
        option network 'lan'      
        option mode 'ap' 
        option ssid 'OpenWrt_5G'  
        option encryption 'sae'   
        option key 'mojeheslo'  
